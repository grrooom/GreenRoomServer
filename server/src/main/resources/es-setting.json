{
  "index": {
    "max_ngram_diff": 10
  },
  "analysis": {
    "char_filter": {
      "remove_whitespace": {
        "type": "pattern_replace",
        "pattern": "\\s+",
        "replacement": ""
      }
    },
    "tokenizer": {
      "ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 1,
        "max_gram": 10,
        "token_chars": ["letter", "digit"]
      }
    },
    "filter": {
      "unique_filter": {
        "type": "unique",
        "only_on_same_position": false
      }
    },
    "analyzer": {
      "custom_analyzer": {
        "type": "custom",
        "char_filter": ["remove_whitespace"],
        "tokenizer": "ngram_tokenizer",
        "filter": [
          "unique_filter"
        ]
      }
    }
  }
}
